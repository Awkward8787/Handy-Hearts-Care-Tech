# Names only. Copy to .env.local for the Vite dev server. Do not commit values.
# Vite exposes only variables that start with VITE_ to the browser.

# Supabase project URL. Used only for internal staff sign-in. Guests do not use it.
VITE_SUPABASE_URL=

# Supabase anon key. Public by design. Used only for internal staff sign-in. Never put the service role key here.
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key. Optional. Payments stay off until this is set and the server secret is set.
VITE_STRIPE_PUBLISHABLE_KEY=

# API origin with no trailing slash. Leave empty to use the same origin (Vite proxies /api in dev).
VITE_API_BASE_URL=

# IANA time zone used for same-day and weekend pricing. Optional. Code default is UTC.
# Set the same value as BUSINESS_TIMEZONE on the server.
VITE_BUSINESS_TIMEZONE=

# Public site origin with no trailing slash. Optional. Code default is https://hhcaretech.com.
VITE_PUBLIC_SITE_URL=
