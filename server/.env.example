# Names only. Copy to server/.env. Do not commit values.

# Port the API listens on. Optional. Code default is 3000.
PORT=

# Comma-separated browser origins allowed to call the API. Optional. Code default is http://localhost:5173.
CORS_ORIGINS=

# Set to true when the process is behind a reverse proxy so rate limits see the client address.
TRUST_PROXY=

# IANA time zone for same-day and weekend pricing. Optional. Code default is UTC.
# Set the same value as VITE_BUSINESS_TIMEZONE.
BUSINESS_TIMEZONE=

# Public site origin with no trailing slash. Required for provider payout setup links.
PUBLIC_SITE_URL=

# Stripe secret key. Required before payment routes accept charges.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Required before payment notices are accepted.
STRIPE_WEBHOOK_SECRET=

# ISO 3166-1 alpha-2 country for new Stripe Connect accounts. Required before payout setup.
STRIPE_CONNECT_COUNTRY=

# Supabase project URL. Required to verify signed-in callers.
SUPABASE_URL=

# Supabase anon key. Required to verify signed-in callers. Not the service role key.
SUPABASE_ANON_KEY=

# Supabase service role key. Server only. Required to record paid bookings and save payout accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Guest store. "supabase" uses the service role. "file" writes server/data/store.json.
# When unset, local development uses the file store and production refuses guest writes.
DATA_DRIVER=

# Email confirmation. All three are required before email is attempted. No default port.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Text confirmation. All three are required before a text is attempted. The phone must already include a leading +.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
